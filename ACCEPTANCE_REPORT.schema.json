{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-agent-eval-infra.local/ACCEPTANCE_REPORT.schema.json",
  "title": "Finance Agent Acceptance Report",
  "description": "Signable scorecard for a finance agent evaluated across composed suites in parallel. No suite (including FINSABER) vetoes another. This schema versions the exam paper (protocol) separately from the agent's answers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "generated_at",
    "agent",
    "protocol_hash",
    "suites",
    "admission"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Acceptance report schema version."
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id for this report instance (UUID recommended)."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the report was composed."
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256 of the canonical JSON list of per-suite protocol hashes. Changing dates, universe, costs, data vintage, or execution timing must change this digest."
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/suite_result"
      }
    },
    "admission": {
      "$ref": "#/$defs/admission"
    },
    "artifacts": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "description": "Report-level artifacts (assembled PDF, signed digest, etc.)."
    },
    "signatures": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/signature"
      },
      "description": "Detached signatures. This schema stores slots; it does not define a crypto suite."
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "extra": { "type": "object", "additionalProperties": true }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id"],
      "properties": {
        "suite_id": {
          "type": "string",
          "description": "Canonical suite id, e.g. finsaber.long_horizon."
        },
        "date_from": {
          "type": ["string", "null"],
          "description": "Inclusive start date (YYYY-MM-DD) or live as-of."
        },
        "date_to": {
          "type": ["string", "null"],
          "description": "Inclusive end date (YYYY-MM-DD)."
        },
        "universe": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tickers / assets visible to the agent."
        },
        "data_vintage": {
          "type": ["string", "null"],
          "description": "Dataset name, snapshot date, or tool-manifest fingerprint."
        },
        "costs": {
          "type": "object",
          "additionalProperties": true,
          "description": "Commission, slippage, liquidity cap, LLM cost flags."
        },
        "execution_timing": {
          "type": ["string", "null"],
          "description": "e.g. next_open, same_close. FINSABER honesty metrics default to next_open; this is suite-level, not a global veto."
        },
        "extra": {
          "type": "object",
          "additionalProperties": true,
          "description": "Suite-specific protocol fields (llm profile, tool manifest path, ...)."
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"] },
        "higher_is_better": { "type": ["boolean", "null"] },
        "source": {
          "type": ["string", "null"],
          "description": "Upstream field, e.g. FINSABER metrics.json#sharpe_ratio."
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "metric", "op", "passed"],
      "properties": {
        "gate_id": { "type": "string" },
        "metric": { "type": "string" },
        "op": {
          "type": "string",
          "enum": ["gte", "lte", "gt", "lt", "eq", "neq"]
        },
        "threshold": {
          "type": ["number", "string", "boolean", "null"]
        },
        "actual": {
          "type": ["number", "string", "boolean", "null"]
        },
        "passed": { "type": "boolean" },
        "required": { "type": "boolean", "default": true },
        "rationale": { "type": "string", "default": "" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "e.g. metrics_json, equity_curve, tool_trace, decision_db, run_config."
        },
        "path": { "type": "string" },
        "media_type": { "type": ["string", "null"] }
      }
    },
    "suite_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "status", "protocol"],
      "properties": {
        "suite_id": {
          "type": "string",
          "enum": [
            "finsaber.long_horizon",
            "stockbench.daily_sim",
            "ama.multi_market_live",
            "deepfund.fund_arena",
            "fintoolbench.tool_compliance"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "skip", "error"]
        },
        "protocol": { "$ref": "#/$defs/protocol" },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/metric" }
        },
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate" }
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "traces_path": { "type": ["string", "null"] },
        "notes": { "type": "string", "default": "" },
        "upstream_cli": {
          "type": ["string", "null"],
          "description": "Official upstream command this suite composes."
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "kernel", "required_suites"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["promote", "hold", "reject"],
          "description": "Scorecard completeness only (not a FINSABER-kernel veto). promote = every required suite produced a score (pass or fail); hold = a required suite is missing or skipped; reject = a required suite errored and could not be scored. Per-suite pass/fail lives on suites[]."
        },
        "kernel": {
          "type": "string",
          "default": "parallel_scorecard",
          "description": "Scoring mode. parallel_scorecard = no suite vetoes another. Kept for schema compatibility; not a required suite_id."
        },
        "required_suites": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "optional_suites": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rationale": { "type": "string" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "signer"],
      "properties": {
        "role": {
          "type": "string",
          "description": "e.g. author, reviewer, compliance, system."
        },
        "signer": { "type": "string" },
        "signed_at": { "type": ["string", "null"], "format": "date-time" },
        "digest": {
          "type": ["string", "null"],
          "description": "Digest of the canonical report body excluding this signatures array."
        },
        "signature": { "type": ["string", "null"] },
        "key_id": { "type": ["string", "null"] }
      }
    }
  }
}
