# FinAgentSandbox — placeholder env only. Copy to .env and fill locally.
# Never commit .env, PATs, OIDC blobs, or real keys.

# --- xAI / Grok harness -------------------------------------------------
# Chat Completions (OpenAI-compatible). OIDC refresh may overwrite these
# from ~/.grok/auth.json when GROK_AUTH_JSON is set.
XAI_API_KEY=
XAI_API_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_BASE=

GROK_EVAL_BACKEND=api
GROK_EVAL_MODEL=grok-4.20-0309-non-reasoning
GROK_EVAL_CLI_MODEL=grok-4.6
GROK_BIN=grok
GROK_AUTH_JSON=
GROK_EVAL_ARTIFACTS=artifacts/grok_cli
XAI_OIDC_TOKEN_URL=https://auth.x.ai/oauth2/token
XAI_OIDC_MIN_TTL_SEC=900

# Interpreter for suite subprocesses (optional venv)
EVAL_PYTHON=

# --- FINSABER (honesty suite) ------------------------------------------
# Directory that contains price_daily/ parquet. Do not git-lfs the dump here.
FINSABER_DATA_ROOT=

# --- FinMCP / Qieman MCP plugin ----------------------------------------
# PluginFactory "mcp" → McpPlugin.plugin_env. Official CLI env only.
QIEMAN_MCP_SERVER_URL=
QIEMAN_MCP_SCHEMA=
MCP_SERVER_URL=
MCP_SCHEMA_PATH=

# --- Vals Finance Agent (research bench) --------------------------------
TAVILY_API_KEY=
SEC_EDGAR_API_KEY=
SEC_API_KEY=
VALS_API_KEY=

# --- LiveTradeBench -----------------------------------------------------
LTB_EVAL_MODEL=

# --- StockBench / DeepFund optional market data -------------------------
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- FinToolBench judge / RapidAPI (optional) ---------------------------
COMPLIANCE_JUDGE_MODEL=
JUDGE_MODEL=
TOOL_METADATA_PATH=

# --- InvestorBench / HF (optional) --------------------------------------
HUGGING_FACE_HUB_TOKEN=
OPENAI_API_KEY_EMBEDDINGS=
